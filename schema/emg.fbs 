namespace Robotics.Signal;

// A single, fixed-size hardware sample tick.
// Packed inline in arrays to guarantee zero heap fragmentation on the ESP32.
struct AdsSample {
    timestamp_ns:uint64;    // ESP32 monotonic clock uptime tracked in nanoseconds
    status_word:uint32;     // 24-bit ADS1299 STATUS header (Lead-off status/GPIO faults)
    
    // 8-channel array mapping directly to the ADS1299 hardware channels.
    // 24-bit ADC inputs converted to 32-bit floating point microvolts/volts.
    raw_voltages:[float:8]; 
    
    // Placeholders for filtered values if processed downstream or on-chip.
    filtered_envelopes:[float:8];
    rms_features:[float:8];
}

// A bulk-transfer data packet used to batch multiple samples.
// This significantly reduces network/serial overhead compared to single-sample packets.
table EmgPacket {
    packet_seq:uint64;      // Incremental frame counter to catch transmission drops
    samples:[AdsSample];    // Contiguous vector of historical hardware ticks
}

root_type EmgPacket;
